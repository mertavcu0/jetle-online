  <script>
    (function () {
      const FEATURE_STATE_KEY = "jetle-create-listing-v3-feature-state";
      const FEATURE_PANEL_KEY = "jetle-create-listing-v3-feature-panels";

      function normalizedCategory() {
        const category = (document.getElementById("category")?.value || "").trim();
        if (category === "Otomobil") return "auto";
        if (category === "Emlak") return "emlak";
        if (category === "Elektronik") return "electronic";
        return "";
      }

      function toggleCategorySurfacesLegacy() {
        const current = normalizedCategory();

        document.querySelectorAll(".category-surface").forEach((section) => {
          const active =
            (current === "auto" && section.classList.contains("category-auto")) ||
            (current === "emlak" && section.classList.contains("category-emlak")) ||
            (current === "electronic" && section.classList.contains("category-electronic"));
          section.classList.toggle("is-active", active);
        });

        document.querySelectorAll(".category-feature-group").forEach((section) => {
          const active =
            (current === "auto" && section.classList.contains("category-auto")) ||
            (current === "emlak" && section.classList.contains("category-emlak")) ||
            (current === "electronic" && section.classList.contains("category-electronic"));
          section.classList.toggle("is-active", active);
          if (!active) {
            section.querySelectorAll('input[type="checkbox"]').forEach((input) => {
              input.checked = false;
            });
          }
        });

        const categoryChip = document.querySelector(".preview-chip.primary");
        if (categoryChip) {
          categoryChip.textContent =
            current === "auto" ? "Vasıta" :
            current === "emlak" ? "Emlak" :
            current === "electronic" ? "Elektronik" :
            "İlan";
        }
      }

      function text(id, value) {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
      }

      function setPlaceholderState(id, active) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.toggle("is-placeholder-text", !!active);
      }

      function val(id) {
        const el = document.getElementById(id);
        return el ? String(el.value || "").trim() : "";
      }

      function formatPriceLegacy(value) {
        const digits = String(value || "").replace(/\D/g, "");
        if (!digits) return "-";
        return Number(digits).toLocaleString("tr-TR") + " TL";
      }

      function syncPreviewLegacy() {
        const titleRaw = val("title");
        const city = val("city");
        const district = val("district");
        const location = [city, district].filter(Boolean).join(" / ");
        const brand = val("brand");
        const series = val("series");
        const model = val("model");
        const vehicleLine = [brand, series, model].filter(Boolean).join(" ");
        const title = titleRaw || "İlan başlığı";
        const km = val("km") || "KM";
        const year = val("year") || "Yıl";
        const fuel = val("fuel") || "Yakıt";
        const transmission = val("transmission") || "Vites";
        const priceRaw = val("price");
        const price = formatPrice(priceRaw);
        const metaLine = [location, vehicleLine].filter(Boolean).join(" • ") || "Kategori / Şehir";

        text("livePreviewTitle", title);
        text("livePreviewMeta", metaLine);
        text("livePreviewPrice", price);
        text("previewTitle", title);
        text("previewPrice", price);
        text("previewLocation", location || "Konum");
        text("previewSubLocation", location || "Şehir / İlçe");
        text("previewKm", km);
        text("previewYear", year);
        text("previewFuel", fuel);
        text("previewTransmission", transmission);

        setPlaceholderState("livePreviewTitle", !titleRaw);
        setPlaceholderState("previewTitle", !titleRaw);
        setPlaceholderState("livePreviewMeta", !location && !vehicleLine);
        setPlaceholderState("previewLocation", !location);
        setPlaceholderState("previewSubLocation", !location);
        setPlaceholderState("livePreviewPrice", !priceRaw);
        setPlaceholderState("previewPrice", !priceRaw);
        setPlaceholderState("previewKm", !val("km"));
        setPlaceholderState("previewYear", !val("year"));
        setPlaceholderState("previewFuel", !val("fuel"));
        setPlaceholderState("previewTransmission", !val("transmission"));
      }

      function markLoading(group) {
        if (!group) return;
        group.classList.add("field-loading");
        window.setTimeout(() => group.classList.remove("field-loading"), 450);
      }

      function bindLoadingState() {
        const brand = document.getElementById("brand");
        const series = document.getElementById("series");
        const model = document.getElementById("model");
        if (brand && series && !brand.dataset.loadingBound) {
          brand.dataset.loadingBound = "true";
          brand.addEventListener("change", () => {
            markLoading(series.closest(".field-group"));
            if (model) markLoading(model.closest(".field-group"));
          });
        }
        if (series && model && !series.dataset.loadingBound) {
          series.dataset.loadingBound = "true";
          series.addEventListener("change", () => {
            markLoading(model.closest(".field-group"));
          });
        }
      }

      function bindPreviewSync() {
        document.addEventListener("input", (event) => {
          if (event.target.closest("#createForm") || event.target.closest("#dynamicFields")) {
            syncPreview();
            syncElectricFeatureVisibility();
            renderPreviewFeatureBadges();
          }
        });
        document.addEventListener("change", (event) => {
          if (event.target.closest("#createForm") || event.target.closest("#dynamicFields")) {
            syncPreview();
            bindLoadingState();
            toggleCategorySurfaces();
            syncElectricFeatureVisibility();
            renderPreviewFeatureBadges();
          }
        });
      }

      function bindImageSync() {
        const imageInput = document.getElementById("images");
        const livePreviewImg = document.getElementById("livePreviewImg");
        const mediaWrap = document.querySelector(".preview-listing-media");
        if (!imageInput || !livePreviewImg) return;

        if (mediaWrap) mediaWrap.classList.add("is-placeholder");

        imageInput.addEventListener("change", () => {
          const file = imageInput.files && imageInput.files[0];
          if (!file || !file.type.startsWith("image/")) return;
          const reader = new FileReader();
          reader.onload = (event) => {
            livePreviewImg.src = event.target.result;
            mediaWrap?.classList.remove("is-placeholder");
          };
          reader.readAsDataURL(file);
        });
      }

      function bindDamageHover() {
        document.querySelectorAll(".damage-panel .part").forEach((part) => {
          part.addEventListener("mouseenter", () => {
            part.style.filter = "drop-shadow(0 0 6px rgba(37, 99, 235, 0.25))";
          });
          part.addEventListener("mouseleave", () => {
            part.style.filter = "";
          });
        });
      }

      function decorateDamageStatusList() {
        const list = document.getElementById("damageStatusList");
        if (!list) return;

        const apply = () => {
          list.querySelectorAll("span").forEach((item) => {
            const textValue = (item.textContent || "").toLowerCase();
            item.classList.remove("is-original", "is-painted", "is-damaged", "is-changed");
            if (textValue.includes("normal") || textValue.includes("orijinal")) item.classList.add("is-original");
            else if (textValue.includes("boyal")) item.classList.add("is-painted");
            else if (textValue.includes("hasarl")) item.classList.add("is-damaged");
            else if (textValue.includes("değiş") || textValue.includes("degis")) item.classList.add("is-changed");
          });
        };

        apply();
        const observer = new MutationObserver(apply);
        observer.observe(list, { childList: true, subtree: true, characterData: true });
      }

      function toggleCategorySurfaces() {
        const current = normalizedCategory();

        document.querySelectorAll(".category-surface").forEach((section) => {
          const active =
            (current === "auto" && section.classList.contains("category-auto")) ||
            (current === "emlak" && section.classList.contains("category-emlak")) ||
            (current === "electronic" && section.classList.contains("category-electronic"));
          section.classList.toggle("is-active", active);
          if (!active) {
            section.querySelectorAll('input:not([type="hidden"]):not([type="checkbox"]):not([type="file"]), select, textarea').forEach((field) => {
              field.value = "";
            });
          }
        });

        document.querySelectorAll(".category-feature-group").forEach((section) => {
          const active =
            (current === "auto" && section.classList.contains("category-auto")) ||
            (current === "emlak" && section.classList.contains("category-emlak")) ||
            (current === "electronic" && section.classList.contains("category-electronic"));
          section.classList.toggle("is-active", active);
          if (!active) {
            section.querySelectorAll('input[type="checkbox"]').forEach((input) => {
              input.checked = false;
            });
          }
        });

        const categoryChip = document.querySelector(".preview-chip.primary");
        if (categoryChip) {
          categoryChip.textContent =
            current === "auto" ? "Vasıta" :
            current === "emlak" ? "Emlak" :
            current === "electronic" ? "Elektronik" :
            "İlan";
        }
      }

      function formatPrice(value) {
        const digits = String(value || "").replace(/\D/g, "");
        if (!digits) return "";
        return Number(digits).toLocaleString("tr-TR") + " TL";
      }

      function readStoredList(key) {
        try {
          const raw = localStorage.getItem(key);
          const parsed = raw ? JSON.parse(raw) : [];
          return Array.isArray(parsed) ? parsed : [];
        } catch (error) {
          return [];
        }
      }

      function autoFeatureCheckboxes() {
        return Array.from(document.querySelectorAll(".features-root .category-feature-group.category-auto input[type='checkbox']"));
      }

      function isElectricVehicleSelection() {
        return normalizedCategory() === "auto" && /elektr/i.test(val("fuel"));
      }

      function syncElectricFeatureVisibility() {
        const block = document.getElementById("featureBlockEv");
        if (!block) return;
        const shouldShow = isElectricVehicleSelection();
        block.classList.toggle("ev-hidden", !shouldShow);
        block.querySelectorAll("input[type='checkbox']").forEach((input) => {
          input.disabled = !shouldShow;
        });
      }

      function selectedPreviewFeatures() {
        return autoFeatureCheckboxes()
          .filter((input) => input.checked && !input.disabled)
          .map((input) => input.closest("label")?.querySelector(".feature-label")?.textContent.trim() || input.closest("label")?.innerText.trim())
          .filter(Boolean)
          .slice(0, 4);
      }

      function renderPreviewFeatureBadges() {
        const wrap = document.getElementById("previewFeatureBadges");
        if (!wrap) return;
        const features = normalizedCategory() === "auto" ? selectedPreviewFeatures() : [];
        if (!features.length) {
          wrap.innerHTML = '<span class="preview-feature-badge is-placeholder">Seçilen özellikler burada görünür</span>';
          return;
        }
        wrap.innerHTML = features.map((feature) => `<span class="preview-feature-badge">${feature}</span>`).join("");
      }

      function persistFeatureState() {
        const checkedIds = autoFeatureCheckboxes().filter((input) => input.checked).map((input) => input.id);
        const openPanels = Array.from(document.querySelectorAll(".features-root details[id]"))
          .filter((panel) => panel.open)
          .map((panel) => panel.id);
        localStorage.setItem(FEATURE_STATE_KEY, JSON.stringify(checkedIds));
        localStorage.setItem(FEATURE_PANEL_KEY, JSON.stringify(openPanels));
      }

      function restoreFeatureState() {
        const checkedIds = new Set(readStoredList(FEATURE_STATE_KEY));
        const openPanels = new Set(readStoredList(FEATURE_PANEL_KEY));

        autoFeatureCheckboxes().forEach((input) => {
          input.checked = checkedIds.has(input.id);
        });

        document.querySelectorAll(".features-root details[id]").forEach((panel) => {
          if (openPanels.size) panel.open = openPanels.has(panel.id);
        });
      }

      function bindFeaturePersistence() {
        document.addEventListener("change", (event) => {
          if (event.target.matches(".features-root input[type='checkbox']")) {
            persistFeatureState();
            renderPreviewFeatureBadges();
          }
        });

        document.querySelectorAll(".features-root details[id]").forEach((panel) => {
          panel.addEventListener("toggle", persistFeatureState);
        });
      }

      function syncPreview() {
        const titleRaw = val("title");
        const city = val("city");
        const district = val("district");
        const location = [city, district].filter(Boolean).join(" / ");
        const brand = val("brand");
        const series = val("series");
        const model = val("model");
        const vehicleLine = [brand, series, model].filter(Boolean).join(" ");
        const title = titleRaw || "Başlık";
        const km = val("km") || "KM";
        const year = val("year") || "Yıl";
        const fuel = val("fuel") || "Yakıt";
        const transmission = val("transmission") || "Vites";
        const priceRaw = val("price");
        const price = formatPrice(priceRaw);
        const metaLine = [location, vehicleLine].filter(Boolean).join(" • ");

        text("livePreviewTitle", title);
        text("livePreviewMeta", metaLine);
        text("livePreviewPrice", price || "Fiyat");
        text("previewTitle", title);
        text("previewPrice", price || "Fiyat");
        text("previewLocation", location || "Konum");
        text("previewLocationDetail", location || "Şehir / İlçe");
        text("previewSubLocation", location || "Şehir / İlçe");
        text("previewKm", km);
        text("previewYear", year);
        text("previewFuel", fuel);
        text("previewTransmission", transmission);

        setPlaceholderState("livePreviewTitle", !titleRaw);
        setPlaceholderState("previewTitle", !titleRaw);
        setPlaceholderState("livePreviewMeta", !location && !vehicleLine);
        setPlaceholderState("previewLocation", !location);
        setPlaceholderState("previewLocationDetail", !location);
        setPlaceholderState("previewSubLocation", !location);
        setPlaceholderState("livePreviewPrice", !priceRaw);
        setPlaceholderState("previewPrice", !priceRaw);
        setPlaceholderState("previewKm", !val("km"));
        setPlaceholderState("previewYear", !val("year"));
        setPlaceholderState("previewFuel", !val("fuel"));
        setPlaceholderState("previewTransmission", !val("transmission"));
      }

      function initRealtimeSurface() {
        restoreFeatureState();
        toggleCategorySurfaces();
        syncElectricFeatureVisibility();
        syncPreview();
        renderPreviewFeatureBadges();
        bindLoadingState();
        bindPreviewSync();
        bindImageSync();
        bindDamageHover();
        decorateDamageStatusList();
        bindFeaturePersistence();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initRealtimeSurface);
      } else {
        initRealtimeSurface();
      }
    })();
  </script>
</body>
</html>
