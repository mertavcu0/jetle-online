<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>İlan Ver - Jetle</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    html,
    body.create-v3-page {
      background: #f3f4f6 !important;
      color: #0f172a !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    body.create-v3-page::before,
    body.create-v3-page::after,
    .create-v3-shell::before,
    .create-v3-shell::after {
      content: none !important;
      display: none !important;
    }

    .create-v3-page {
      margin: 0;
      background: #f3f4f6;
      color: #0f172a;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .create-v3-topbar {
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(255, 255, 255, 0.98);
      border-bottom: 1px solid #d8e0e8;
      box-shadow: 0 4px 10px rgba(15, 23, 42, 0.04);
      backdrop-filter: blur(10px);
    }

    .create-v3-topbar-inner {
      max-width: 1360px;
      margin: 0 auto;
      padding: 8px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .create-v3-brand {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      text-decoration: none;
      color: #0f172a;
      font-size: 19px;
      font-weight: 900;
      letter-spacing: -0.02em;
      white-space: nowrap;
    }

    .create-v3-brand .jetle {
      color: #2563eb;
    }

    .create-v3-nav {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      flex-wrap: wrap;
    }

    .create-v3-nav a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 34px;
      padding: 0 11px;
      border-radius: 7px;
      color: #334155;
      text-decoration: none;
      font-size: 13px;
      font-weight: 700;
      transition: background 0.18s ease, color 0.18s ease;
    }

    .create-v3-nav a:hover {
      background: #f1f5f9;
      color: #0f172a;
    }

    .create-v3-nav .primary-link {
      background: #2563eb;
      color: #fff;
      box-shadow: 0 4px 10px rgba(37, 99, 235, 0.14);
    }

    .create-v3-nav .primary-link:hover {
      background: #1d4ed8;
      color: #fff;
    }

    .create-v3-shell {
      min-height: 100vh;
      padding: 4px 12px 14px;
      position: relative;
      z-index: 1;
      opacity: 1 !important;
      visibility: visible !important;
      height: auto !important;
      max-height: none !important;
      overflow: visible !important;
    }

    .create-v3-layout {
      max-width: 1360px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 390px;
      gap: 14px;
      align-items: start;
      position: relative;
      z-index: 1;
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
    }

    .create-v3-form-card,
    .create-v3-preview-wrap {
      background: #fff;
      border: 1px solid #e6ebf0;
      border-radius: 10px;
      box-shadow: 0 3px 8px rgba(15, 23, 42, 0.035);
      position: relative;
      z-index: 1;
      opacity: 1 !important;
      visibility: visible !important;
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
    }

    .create-v3-form-card {
      padding: 10px 10px 14px;
    }

    .create-v3-progress {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 8px;
      margin-bottom: 10px;
    }

    .step-progress-item {
      position: relative;
      display: grid;
      gap: 6px;
      min-height: 58px;
      padding: 8px 9px;
      border: 1px solid #d8e0e8;
      border-radius: 10px;
      background: #f7f8fa;
      color: #64748b;
      opacity: 0.68;
      transition: opacity 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    .step-progress-item::after {
      content: "";
      position: absolute;
      top: 23px;
      left: calc(100% + 4px);
      width: 6px;
      height: 2px;
      background: #cbd5e1;
    }

    .step-progress-item:last-child::after {
      display: none;
    }

    .step-progress-item span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 27px;
      height: 27px;
      border-radius: 999px;
      background: #dbe2ea;
      color: #0f172a;
      font-size: 12px;
      font-weight: 900;
    }

    .step-progress-item strong {
      font-size: 11px;
      line-height: 1.25;
      color: #0f172a;
      font-weight: 800;
    }

    .step-progress-item small {
      display: none;
    }

    .step-progress-item.active {
      opacity: 1;
      border-color: #3b82f6;
      background: #f6f9ff;
      box-shadow: 0 6px 14px rgba(37, 99, 235, 0.12), 0 0 0 1px rgba(59, 130, 246, 0.22);
    }

    .step-progress-item.active span,
    .step-progress-item.done span {
      background: #2563eb;
      color: #fff;
    }

    .step-progress-item.done {
      opacity: 0.92;
      border-color: #c9d8ea;
      background: #f8fafc;
    }

    .step-progress-item.done span {
      font-size: 0;
      position: relative;
    }

    .step-progress-item.done span::before {
      content: "\2713";
      font-size: 14px;
      line-height: 1;
    }

    .step-panel {
      display: none;
      border: 1px solid #e8edf3;
      border-radius: 8px;
      background: #fff;
      padding: 8px;
      box-shadow: 0 1px 4px rgba(15, 23, 42, 0.03);
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.22s ease, transform 0.22s ease;
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
    }

    .step-panel.active {
      display: block;
      opacity: 1;
      transform: translateY(0);
    }

    .step-panel[data-step="2"].active {
      display: grid;
      gap: 16px;
      align-content: start;
      justify-items: stretch;
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
    }

    .step-panel h2 {
      margin: 0 0 6px;
      font-size: 16px;
      font-weight: 900;
      color: #0f172a;
      letter-spacing: -0.02em;
    }

    .step-panel-note {
      margin: 0 0 8px;
      color: #6b7280;
      font-size: 11px;
      line-height: 1.35;
    }

    .step-panel-note:empty {
      display: none;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
      align-items: start !important;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field-group.full-width {
      grid-column: 1 / -1;
    }

    .field-group label {
      font-size: 11px;
      font-weight: 800;
      color: #475569;
      letter-spacing: 0.01em;
    }

    .field-group input,
    .field-group select,
    .field-group textarea {
      width: 100%;
      border: 1px solid #b7c4d0;
      border-radius: 6px;
      background: #fff;
      color: #0f172a;
      font: inherit;
      font-size: 13px;
      line-height: 1.35;
      padding: 8px 11px;
      box-sizing: border-box;
      transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
    }

    .field-group select {
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      padding-right: 38px;
      background-image:
        linear-gradient(45deg, transparent 50%, #64748b 50%),
        linear-gradient(135deg, #64748b 50%, transparent 50%);
      background-position:
        calc(100% - 15px) calc(50% - 2px),
        calc(100% - 10px) calc(50% - 2px);
      background-size: 5px 5px, 5px 5px;
      background-repeat: no-repeat;
    }

    .field-group input,
    .field-group select {
      min-height: 40px;
    }

    .field-group textarea {
      min-height: 112px;
      resize: vertical;
    }

    .field-group input:focus,
    .field-group select:focus,
    .field-group textarea:focus {
      outline: none;
      border-color: #2563eb;
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.11);
    }

    .field-group input:hover,
    .field-group select:hover,
    .field-group textarea:hover {
      border-color: #9fb0c2;
    }

    .field-group input::placeholder,
    .field-group textarea::placeholder {
      color: #94a3b8;
    }

    .field-group select:disabled,
    .field-group input:disabled,
    .field-group textarea:disabled {
      background: #f8fafc;
      color: #94a3b8;
      border-color: #d7dee7;
      cursor: not-allowed;
      opacity: 1;
    }

    .field-hint {
      font-size: 9px;
      color: #6b7280;
      line-height: 1.3;
    }

    .field-group.field-muted {
      padding: 4px;
      border: 1px solid #d9e1e8;
      border-radius: 4px;
      background: #fff;
    }

    .field-group.field-muted label {
      color: #64748b;
    }

    .field-group.field-muted .field-hint {
      color: #475569;
    }

    .field-proxy {
      display: none !important;
    }

    #dynamicFields {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      visibility: visible !important;
      overflow: visible !important;
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      margin-bottom: 6px;
      align-items: start !important;
      align-content: start !important;
    }

    #dynamicFields > * {
      grid-column: 1 / -1;
      min-width: 0;
      width: 100%;
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
    }

    #dynamicFields .form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
      align-items: start !important;
    }

    .vehicle-dynamic-shell {
      display: grid;
      gap: 18px;
      width: 100%;
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
    }

    .vehicle-dynamic-primary,
    .vehicle-dynamic-secondary {
      display: grid;
      gap: 18px;
      width: 100%;
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
      align-items: start !important;
    }

    .vehicle-dynamic-primary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .vehicle-dynamic-secondary {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding-top: 4px;
      border-top: 1px solid #e5e7eb;
    }

    #dynamicFields .field-group {
      gap: 6px;
    }

    #dynamicFields .field-group label {
      font-size: 11px;
    }

    #dynamicFields .field-group input,
    #dynamicFields .field-group select {
      min-height: 40px;
      font-size: 13px;
    }

    #step2DescriptionField {
      margin-top: 0 !important;
      height: auto !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
    }

    .auto-secondary-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .package-field.is-pending {
      opacity: 0.58;
    }

    .package-field.is-pending input {
      background: #f8fafc;
      color: #94a3b8;
      cursor: not-allowed;
    }

    .step-message {
      min-height: 18px;
      margin: 8px 0 0;
      color: #dc2626;
      font-size: 12px;
    }

    .step-actions {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin-top: 8px;
    }

    .btn-step {
      border: 0;
      border-radius: 7px;
      padding: 10px 13px;
      font: inherit;
      font-weight: 800;
      cursor: pointer;
      transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    .btn-step:hover:not(:disabled) {
      transform: translateY(-1px);
    }

    .btn-step-primary {
      background: #2563eb;
      color: #fff;
      box-shadow: 0 5px 10px rgba(37, 99, 235, 0.16);
    }

    .btn-step-primary:hover:not(:disabled) {
      background: #1d4ed8;
    }

    .btn-step-secondary {
      background: #eef2f7;
      color: #0f172a;
    }

    .btn-step:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      box-shadow: none;
    }

    .create-v3-section-block {
      margin-top: 6px;
      padding: 5px;
      border: 1px solid #e1e7ee;
      border-radius: 4px;
      background: #fff;
    }

    .create-v3-section-block h3 {
      margin: 0 0 8px;
      font-size: 14px;
      font-weight: 900;
      color: #0f172a;
    }

    .create-v3-section-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 4px;
      padding-bottom: 4px;
      border-bottom: 1px solid #e5e7eb;
    }

    .create-v3-section-head p {
      margin: 2px 0 0;
      font-size: 10px;
      line-height: 1.3;
      color: #6b7280;
    }

    .category-surface,
    .category-feature-group {
      display: none;
    }

    .category-surface.is-active,
    .category-feature-group.is-active {
      display: block;
    }

    .category-surface-stack {
      display: grid;
      gap: 6px;
    }

    .photo-upload-wrap {
      border: 1px dashed #7f93a8;
      border-radius: 6px;
      background: #f9fafb;
      padding: 8px;
    }

    .photo-upload-wrap.drag-over {
      border-color: #2563eb;
      background: #eff6ff;
    }

    .photo-drop-label {
      display: grid;
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 10px;
      margin-bottom: 10px;
      cursor: pointer;
      align-items: center;
    }

    .photo-drop-label::before {
      content: "+";
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 8px;
      background: #dbeafe;
      color: #1d4ed8;
      font-size: 18px;
      font-weight: 800;
    }

    .photo-drop-label strong {
      display: block;
      font-size: 13px;
      color: #0f172a;
      margin-bottom: 2px;
    }

    .photo-drop-label span {
      color: #64748b;
      font-size: 11px;
      line-height: 1.45;
    }

    .photo-input-hidden {
      width: 100%;
      margin-bottom: 8px;
    }

    .create-v3-gallery-placeholders {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 5px;
      margin-top: 6px;
    }

    .create-v3-gallery-slot {
      min-height: 52px;
      border: 1px dashed #c9d3de;
      border-radius: 6px;
      background: #f8fafc;
      display: grid;
      place-items: center;
      color: #94a3b8;
      font-size: 10px;
      font-weight: 700;
    }

    .preview-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      min-height: 10px;
    }

    .preview-item {
      position: relative;
      border-radius: 6px;
      overflow: hidden;
      background: #e5e7eb;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
    }

    .preview-item:first-child::after {
      content: "Kapak";
      position: absolute;
      left: 6px;
      bottom: 6px;
      display: inline-flex;
      align-items: center;
      min-height: 18px;
      padding: 0 6px;
      border-radius: 999px;
      background: rgba(15, 23, 42, 0.84);
      color: #fff;
      font-size: 9px;
      font-weight: 800;
    }

    .preview-item img {
      display: block;
      width: 104px;
      height: 78px;
      object-fit: cover;
    }

    .remove-btn {
      position: absolute;
      top: 6px;
      right: 6px;
      border: 0;
      border-radius: 999px;
      width: 22px;
      height: 22px;
      background: rgba(17, 24, 39, 0.82);
      color: #fff;
      cursor: pointer;
      font-weight: 700;
    }

    .field-group.field-loading select,
    .field-group.field-loading input {
      border-color: #93c5fd;
      background-color: #f8fbff;
    }

    .field-group.field-loading label::after {
      content: " • yükleniyor";
      color: #2563eb;
      font-weight: 700;
    }

    .features-root {
      margin-top: 8px;
      display: grid;
      gap: 12px;
    }

    .features-page-title {
      margin: 0;
      font-size: 19px;
      color: #0f172a;
      font-weight: 900;
      letter-spacing: -0.02em;
    }

    .features-block {
      border: 1px solid #dbe4ee;
      border-radius: 8px;
      background: #fff;
      overflow: hidden;
      box-shadow: 0 3px 10px rgba(15, 23, 42, 0.045);
    }

    .features-block > .damage-panel {
      padding: 8px;
    }

    .features-block h3 {
      margin: 0;
      font-size: 14px;
      font-weight: 900;
      color: #0f172a;
    }

    .features-block summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      list-style: none;
      cursor: pointer;
      padding: 12px 14px;
      background: linear-gradient(180deg, #fbfdff 0%, #f8fbff 100%);
      border-bottom: 1px solid #e8eef5;
    }

    .features-block summary::-webkit-details-marker {
      display: none;
    }

    .features-block summary::after {
      content: "+";
      width: 24px;
      height: 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: #eff6ff;
      color: #1d4ed8;
      font-size: 14px;
      font-weight: 800;
      flex: 0 0 auto;
    }

    .features-block[open] summary::after {
      content: "\2212";
    }

    .features-grid-4 {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
      padding: 14px;
    }

    .feature-check {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 10px 12px;
      border: 1px solid #dbe4ee;
      border-radius: 8px;
      background: #fff;
      color: #334155;
      font-size: 12px;
      font-weight: 700;
      line-height: 1.25;
      cursor: pointer;
      transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    }

    .feature-check:hover {
      border-color: #bfd0e2;
      background: #f8fbff;
      box-shadow: 0 4px 10px rgba(37, 99, 235, 0.06);
      transform: translateY(-1px);
    }

    .feature-check input {
      accent-color: #2563eb;
      width: 18px;
      height: 18px;
      margin: 0;
      flex: 0 0 auto;
    }

    .feature-label {
      display: block;
      min-width: 0;
      color: #1e293b;
    }

    .category-feature-group.ev-hidden {
      display: none !important;
    }

    .damage-panel {
      display: grid;
      gap: 8px;
    }

    .damage-header {
      display: grid;
      gap: 5px;
    }

    .damage-header p {
      margin: 0;
      font-size: 10px;
      line-height: 1.3;
      color: #6b7280;
    }

    .damage-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
    }

    .damage-btn {
      border: 1px solid #d1d5db;
      border-radius: 999px;
      background: #fff;
      color: #334155;
      padding: 4px 7px;
      font: inherit;
      font-size: 8px;
      font-weight: 800;
      cursor: pointer;
      transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
    }

    .damage-btn.active {
      border-color: #93c5fd;
      background: #eff6ff;
      color: #1d4ed8;
    }

    .car-wrapper {
      padding: 6px;
      border-radius: 5px;
      background: #f8fafc;
      border: 1px solid #d8e0e8;
    }

    .damage-parts-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 5px;
    }

    .part {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 38px;
      padding: 6px 5px;
      border-radius: 4px;
      border: 1px solid #cfd8e3;
      background: #f3f5f7;
      color: #334155;
      font-size: 9px;
      font-weight: 700;
      text-align: center;
      line-height: 1.2;
      cursor: pointer;
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }

    .part:hover {
      border-color: #2563eb;
      background: #eef4ff;
      transform: translateY(-1px);
    }

    .part.painted {
      background: #dbeafe;
      border-color: #60a5fa;
      color: #1e40af;
    }

    .part.changed {
      background: #fee2e2;
      border-color: #ef4444;
      color: #991b1b;
    }

    .part.damaged {
      background: #fef3c7;
      border-color: #f59e0b;
      color: #92400e;
    }

    .damage-status-list {
