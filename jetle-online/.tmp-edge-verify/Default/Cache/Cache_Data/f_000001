      border-radius: 8px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.045);
    }

    .preview-listing-media {
      position: relative;
      aspect-ratio: 16 / 10;
      background:
        linear-gradient(180deg, rgba(15, 23, 42, 0.05), rgba(15, 23, 42, 0.12)),
        linear-gradient(135deg, #eef2f7 0%, #e2e8f0 55%, #d8e0ea 100%);
