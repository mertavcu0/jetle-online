    .preview-listing-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .preview-listing-media.is-placeholder img {
      opacity: 0;
    }

    .preview-listing-media.is-placeholder::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.45) 50%, rgba(255,255,255,0) 100%),
        linear-gradient(135deg, #e7ebf0 0%, #f1f4f7 50%, #e5e7eb 100%);
      animation: preview-sheen 2.2s linear infinite;
    }

    .preview-listing-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      display: inline-flex;
      align-items: center;
      min-height: 22px;
      padding: 0 8px;
      border-radius: 999px;
      background: rgba(15, 23, 42, 0.82);
      color: #fff;
      font-size: 9px;
      font-weight: 800;
    }

    .preview-listing-media::after {
      content: "Kapak görseli";
      position: absolute;
      right: 10px;
      bottom: 10px;
      display: inline-flex;
      align-items: center;
      min-height: 20px;
      padding: 0 7px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.92);
      color: #0f172a;
      font-size: 9px;
      font-weight: 800;
    }

    .preview-listing-body {
      padding: 7px;
    }

    .is-placeholder-text {
      color: #94a3b8 !important;
    }

    @keyframes preview-sheen {
      0% { background-position: -180px 0, 0 0; }
      100% { background-position: 340px 0, 0 0; }
    }

    .preview-badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 3px;
      margin-bottom: 4px;
    }

    .preview-chip {
      display: inline-flex;
      align-items: center;
      min-height: 17px;
      padding: 0 5px;
      border-radius: 999px;
      background: #f8fafc;
      border: 1px solid #e5e7eb;
      color: #334155;
      font-size: 7.5px;
      font-weight: 800;
    }

    .preview-chip.primary {
      background: #eff6ff;
      border-color: #bfdbfe;
      color: #1d4ed8;
    }

    .preview-listing-title {
      margin: 0 0 2px;
      font-size: 16px;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.28;
      letter-spacing: -0.02em;
    }

    .preview-listing-meta {
      margin: 0 0 2px;
      color: #6b7280;
      font-size: 7.5px;
      line-height: 1.35;
    }

    .preview-submeta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      margin: 0 0 3px;
      color: #6b7280;
      font-size: 8px;
      line-height: 1.35;
    }

    .preview-status-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin: 0 0 4px;
    }

    .preview-status-pill {
      display: inline-flex;
      align-items: center;
      min-height: 20px;
      padding: 0 7px;
      border-radius: 999px;
      background: #eefbf2;
      border: 1px solid #bbf7d0;
      color: #166534;
      font-size: 9px;
      font-weight: 800;
    }

    .preview-favorite {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 999px;
      border: 1px solid #d8e0e8;
      background: #fff;
      color: #475569;
      font-size: 11px;
      font-weight: 800;
    }

    .preview-listing-price {
      margin: 0 0 4px;
      font-size: 30px;
      font-weight: 900;
      color: #111827;
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .preview-specs {
      display: flex;
      flex-wrap: nowrap;
      gap: 3px;
      margin: 0 0 4px;
      padding-bottom: 5px;
      border-bottom: 1px solid #eef2f7;
    }

    .preview-spec {
      min-width: 0;
      flex: 1 1 25%;
      padding: 0;
      border-radius: 0;
      background: transparent;
      border: 0;
    }

    .preview-spec strong {
      display: block;
      margin-bottom: 2px;
      font-size: 7px;
      color: #64748b;
    }

    .preview-spec span {
      font-size: 8.5px;
      font-weight: 800;
      color: #0f172a;
    }

    .preview-highlights {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2px;
    }

    .preview-feature-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 0 0 8px;
      min-height: 28px;
    }

    .preview-feature-badge {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      padding: 0 9px;
      border-radius: 999px;
      background: #f8fafc;
      border: 1px solid #dbe4ee;
      color: #0f172a;
      font-size: 10px;
      font-weight: 800;
      white-space: nowrap;
    }

    .preview-feature-badge.is-placeholder {
      color: #94a3b8;
      border-style: dashed;
    }

    .preview-highlight {
      padding: 4px 5px;
      border-radius: 4px;
      background: #fafbfd;
      border: 1px solid #e5e7eb;
    }

    .preview-highlight strong {
      display: block;
      margin-bottom: 2px;
      font-size: 9px;
      color: #475569;
    }

    .preview-highlight span {
      font-size: 10px;
      color: #0f172a;
      font-weight: 800;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      border: 0;
    }

    @media (max-width: 1200px) {
      .create-v3-layout {
        grid-template-columns: 1fr 350px;
      }

