      .vehicle-dynamic-secondary,
      .auto-secondary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 760px) {
      .create-v3-shell,
      .create-v3-layout,
      .create-v3-form-card,
      .step-panel,
      .step-panel.active,
      #dynamicFields,
      #dynamicFields .form-grid,
      .vehicle-dynamic-shell,
      .vehicle-dynamic-primary,
      .vehicle-dynamic-secondary {
        height: auto !important;
        min-height: auto !important;
        max-height: none !important;
        overflow: visible !important;
      }

      .create-v3-layout {
        display: grid;
        grid-template-columns: 1fr !important;
        align-items: start !important;
      }

      .create-v3-preview-column {
        position: relative !important;
        top: auto !important;
        align-self: auto !important;
        order: 2;
      }

      .create-v3-form-card {
        order: 1;
        padding-bottom: 18px;
      }

      .create-v3-topbar-inner {
        flex-direction: column;
        align-items: flex-start;
        padding: 10px 14px;
      }

      .create-v3-nav {
        width: 100%;
        justify-content: flex-start;
      }

      .create-v3-progress,
      .form-grid,
      #dynamicFields,
      .damage-parts-grid,
      #dynamicFields .form-grid,
      .vehicle-dynamic-primary,
      .vehicle-dynamic-secondary,
      .auto-secondary-grid,
      .preview-highlights {
        grid-template-columns: 1fr;
      }

      .create-v3-progress {
        gap: 8px;
        margin-bottom: 10px;
      }

      .step-progress-item {
        min-height: 60px;
        padding: 9px 10px;
      }

      .preview-specs {
        flex-wrap: wrap;
      }

      .preview-spec {
        flex: 1 1 calc(50% - 4px);
      }

      .create-v3-form-card,
      .step-panel,
      .create-v3-preview-wrap {
        padding: 14px;
      }

      .create-v3-preview-wrap {
        margin-top: 10px;
      }

      .photo-drop-label {
        grid-template-columns: 1fr;
      }

      .step-actions {
        flex-direction: column;
      }

      .step-actions .btn-step {
        width: 100%;
      }
    }
  </style>
</head>
