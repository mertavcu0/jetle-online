        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 1080px) {
      .create-v3-layout {
        grid-template-columns: 1fr;
        height: auto !important;
        min-height: auto !important;
        max-height: none !important;
